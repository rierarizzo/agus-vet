---
interface Props {
  title: string
  description?: string
}

const { title, description = 'Veterinaria Agus Vet - Más de 15 años de experiencia cuidando a tus mascotas. Servicios: consultas médicas, vacunación, cirugías, estética canina, laboratorio y emergencias 24/7.' } = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={Astro.url} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="veterinaria, mascota, perro, gato, consulta veterinaria, vacunación, cirugía, emergencia veterinary, Agus Vet" />
    <meta name="author" content="Agus Vet" />
    <meta name="robots" content="index, follow" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:locale" content="es_EC" />
    <meta property="og:site_name" content="Agus Vet" />
    <meta property="og:image" content={new URL('/og-image.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og-image.png', Astro.site)} />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700;800&family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "VeterinaryCare",
      "name": "Agus Vet",
      "description": "Más de 15 años de experiencia proporcionando atención médica de calidad para tus mascotas.",
      "url": "https://agusvet.com",
      "telephone": "(555) 123-4567",
      "email": "contacto@agusvet.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Av. Principal 123",
        "addressLocality": "Ciudad",
        "addressCountry": "EC"
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
          "opens": "08:00",
          "closes": "20:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": "Sunday",
          "opens": "09:00",
          "closes": "14:00",
          "description": "Solo emergencias"
        }
      ],
      "image": "https://agusvet.com/og-image.png",
      "sameAs": [
        "https://www.facebook.com/agusvet",
        "https://www.instagram.com/agusvet",
        "https://twitter.com/agusvet"
      ]
    })} />
  </head>
  <body>
    <div class="app">
      <slot />
    </div>
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="../scripts/main.js"></script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
