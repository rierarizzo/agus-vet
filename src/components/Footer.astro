---
import { socialLinks } from '../data'
import FacebookIcon from './icons/FacebookIcon.astro'
import InstagramIcon from './icons/InstagramIcon.astro'
import TwitterIcon from './icons/TwitterIcon.astro'

const iconMap = {
  facebook: FacebookIcon,
  instagram: InstagramIcon,
  twitter: TwitterIcon,
}
---

<footer class="footer">
  <div class="footer-content">
    <div class="footer-logo">
      <svg class="logo-icon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 10c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm6-3c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zM6 7c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm3.5-3C8.4 4 7.5 4.9 7.5 6s.9 2 2 2 2-.9 2-2-.9-2-2-2zm5 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm-2.5 8c-2.8 0-5 2.2-5 5 0 1.4.6 2.7 1.5 3.6.9.9 2.2 1.4 3.5 1.4s2.6-.5 3.5-1.4c.9-.9 1.5-2.2 1.5-3.6 0-2.8-2.2-5-5-5z"/>
      </svg>
      <span>Agus Vet</span>
    </div>
    <p>&copy; {new Date().getFullYear()} Agus Vet. Todos los derechos reservados.</p>
    <div class="footer-social">
      {socialLinks.map(social => {
        const Icon = iconMap[social.network]
        return (
          <span aria-hidden="true">
            <Icon ariaLabel={social.label} />
          </span>
        )
      })}
    </div>
  </div>
</footer>
