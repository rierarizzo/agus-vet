---
import { contactInfo } from '../data'
import { MapPin, Phone, Mail, Clock, PartyPopper } from '@lucide/astro'
---

<section class="section contact" id="contact">
  <h2>Contáctanos</h2>
  <p class="section-subtitle">Estamos aquí para ayudarte. ¡Escríbenos o visítanos!</p>
  <div class="contact-grid">
    <div class="contact-info">
      <div class="info-item">
        <MapPin class="info-icon" size={24} />
        <div>
          <h4>Dirección</h4>
          <p>{contactInfo.address}</p>
        </div>
      </div>
      <div class="info-item">
        <Phone class="info-icon" size={24} />
        <div>
          <h4>Teléfono</h4>
          <p>{contactInfo.phone}</p>
        </div>
      </div>
      <div class="info-item">
        <Mail class="info-icon" size={24} />
        <div>
          <h4>Email</h4>
          <p>{contactInfo.email}</p>
        </div>
      </div>
      <div class="info-item">
        <Clock class="info-icon" size={24} />
        <div>
          <h4>Horario</h4>
          <p>{contactInfo.hours} · {contactInfo.sundayHours}</p>
        </div>
      </div>
    </div>

    <form class="contact-form" id="contact-form" action="https://formspree.io/f/xpwzgkvb" method="POST">
      <label for="name">Nombre</label>
      <input type="text" id="name" name="name" placeholder="Tu nombre" class="form-input" required />
      <span class="error-message" id="name-error" role="alert"></span>

      <label for="email">Email</label>
      <input type="email" id="email" name="email" placeholder="tu@email.com" class="form-input" required />
      <span class="error-message" id="email-error" role="alert"></span>

      <label for="phone">Teléfono</label>
      <input type="tel" id="phone" name="phone" placeholder="Tu teléfono" class="form-input" />

      <label for="message">Mensaje</label>
      <textarea id="message" name="message" placeholder="¿En qué podemos ayudarte?" rows="5" class="form-input" required></textarea>
      <span class="error-message" id="message-error" role="alert"></span>

      <p class="form-error" id="form-error" role="alert" aria-live="polite"></p>

      <button type="submit" class="submit-button" id="submit-btn">Enviar mensaje</button>
    </form>

    <div class="form-success" id="form-success" hidden>
      <span class="success-icon" aria-hidden="true"><PartyPopper size={48} /></span>
      <h3>¡Mensaje enviado!</h3>
      <p>Gracias por contactarnos. Nos pondremos en contacto contigo muy pronto.</p>
      <button class="submit-button" id="reset-form">Enviar otro mensaje</button>
    </div>
  </div>
  <div class="map-container" id="map-container" data-lat={contactInfo.lat} data-lng={contactInfo.lng}></div>
</section>
